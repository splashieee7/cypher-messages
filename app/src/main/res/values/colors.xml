<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Cypher theme: near-black base with an emerald accent.
        These names intentionally shadow the defaults declared in Fossify Commons
        so every screen, dialog and widget picks them up without further changes.
    -->
    <color name="cypher_base">#070A08</color>
    <color name="cypher_surface">#0D1210</color>
    <color name="cypher_emerald">#10B981</color>
    <color name="cypher_emerald_dark">#059669</color>
    <color name="cypher_text">#E6EDE9</color>

    <!-- Primary / accent -->
    <color name="color_primary">@color/cypher_emerald</color>
    <color name="color_primary_dark">@color/cypher_emerald_dark</color>
    <color name="color_accent">@color/cypher_emerald</color>

    <!-- The "Dark" preset in Customize Colors becomes the Cypher palette -->
    <color name="theme_dark_text_color">@color/cypher_text</color>
    <color name="theme_dark_background_color">@color/cypher_base</color>

    <!-- First-launch defaults (used until the user customizes colors) -->
    <color name="default_text_color">@color/cypher_text</color>
    <color name="default_background_color">@color/cypher_base</color>
    <color name="default_primary_color">@color/cypher_emerald</color>
    <color name="default_accent_color">@color/cypher_emerald</color>
    <color name="default_app_icon_color">@color/cypher_emerald</color>
    <color name="default_widget_text_color">@color/cypher_emerald</color>

    <!-- Received-bubble / selected-row tint: a faint emerald wash instead of grey -->
    <color name="activated_item_foreground">#2A10B981</color>
    <color name="divider_grey">#3310B981</color>

    <!-- Launcher icon -->
    <color name="launcher_background">@color/cypher_base</color>
</resources>
